# Copy this file to .env and fill in real values. Never commit the real .env.

# Postgres (matches docker-compose.yml defaults - change if you're not using it)
DATABASE_URL=postgresql+psycopg://bank_user:bank_pass@localhost:5432/meridian_bank

# Flask app secret (not used for sessions anymore - kept for any Flask internals
# that expect it, e.g. flashing). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BANK_SECRET_KEY=

# JWT signing secret - THIS is what actually protects login sessions now.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fernet key for encrypting PII at rest - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Token lifetimes ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── OTP ──────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Environment ──────────────────────────────────────────────────────────
# development = OTP codes are echoed in API responses (in addition to being
# sent via SMS_PROVIDER) so you're not tabbing to the terminal every login.
# Never do this outside development.
ENV=development

# console (default, prints to terminal) | mock (simulated, no code shown) | twilio (real SMS)
SMS_PROVIDER=console

# Set to 1 once you're serving over real HTTPS (enables Secure cookies + HSTS)
BANK_HTTPS=0

# Twilio (optional, only used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
