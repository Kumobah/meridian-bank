[Unit]
Description=Meridian Bank backend (Flask via Gunicorn)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=blackjew
Group=blackjew
WorkingDirectory=/home/blackjew/labs/secure_bank/backend
EnvironmentFile=/home/blackjew/labs/secure_bank/backend/.env
ExecStart=/home/blackjew/labs/secure_bank/backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=3

# Postgres (in Docker) may take a moment to accept connections after a
# reboot even though docker.service is "started" - Restart=on-failure means
# systemd just retries this unit until Postgres is actually ready, rather
# than needing a fragile fixed sleep.

[Install]
WantedBy=multi-user.target
